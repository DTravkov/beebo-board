# Copy to .env. Compose and backend settings use this file.
# Browser origins for local and Compose development.
# Bind addresses and ports are configured by Uvicorn CLI flags / Compose.
PUBLIC_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
DIRECT_CONNECTIONS_ENABLED=false

# Compose dev uses polling for Windows-mounted source. Disable only when native
# filesystem events work (for example, Linux-native source directories).
# DEV_POLLING=false

# Required by the production Compose stack. Both DNS names point to this host.
APP_DOMAIN=
TURN_DOMAIN=
TURN_PUBLIC_IP=
# Generate a random secret: node -p "require('crypto').randomBytes(32).toString('hex')"
TURN_SECRET=

# For local development against an existing relay, set TURN_URLS and TURN_SECRET.
# Compose production sets TURN_URLS automatically from TURN_DOMAIN.
TURN_URLS=
# TURN_URLS=turn:relay.example.org:3478?transport=udp,turn:relay.example.org:3478?transport=tcp
# Alternatively use TURN_SECRET_FILE instead of TURN_SECRET with local Python.
