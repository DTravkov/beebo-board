# npm run dev and npm start load this file. Compose uses .env.compose instead.
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Comma-separated operator-controlled TURN URLs. Required for default collaboration.
# TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349?transport=tcp
# TURN_SECRET=replace-with-your-coturn-static-auth-secret
# Alternatively set TURN_SECRET_FILE to an operator-provided secret file.
# DIRECT_CONNECTIONS_ENABLED=false
