{
  "name": "beebo-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.10.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node scripts/python.mjs -m server --reload",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/python.mjs -m server",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:client && npm run test:server",
    "test:client": "tsx --test tests/*.test.ts",
    "test:server": "node scripts/python.mjs -m unittest discover -s server/tests -t .",
    "test:browser": "tsx --test tests/browser.smoke.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "konva": "10.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
