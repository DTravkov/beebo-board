# Copy to .env.compose. This is separate from the local-development .env.
APP_DOMAIN=board.example.org
TURN_DOMAIN=relay.example.org
TURN_PUBLIC_IP=203.0.113.10
# Generate a real random secret, at least 32 characters. Never commit it.
TURN_SECRET=

# Mandatory: approved Linux image references ending in @sha256:<64 hex digits>.
# Stock Node/Caddy/coturn images contain OS/optional components outside our npm
# audit, including copyleft packages. No stock defaults are implicitly approved.
NODE_BUILD_IMAGE=
NODE_RUNTIME_IMAGE=
CADDY_IMAGE=
COTURN_IMAGE=
IMAGE_LICENSE_REVIEW=.deploy/image-review.json
