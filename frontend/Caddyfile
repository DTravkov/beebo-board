{$APP_DOMAIN:localhost} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
  @backend path /api /api/* /signal /signal/*
  handle @backend {
    reverse_proxy backend:3001
  }
  handle {
    root * /srv
    file_server
  }
}
